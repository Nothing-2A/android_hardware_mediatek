cc_binary {
    name: "android.hardware.audio.service.mediatek",

    init_rc: ["android.hardware.audio.service.mediatek.rc"],
    relative_install_path: "hw",
    vendor: true,

    srcs: ["service.cpp"],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ] + select(soong_config_variable("android_hardware_audio", "uses_mtkaudio_aidl"), {
        false: [],
        default: ["-DUSES_MTKAUDIO_AIDL"],
    }) + select(soong_config_variable("android_hardware_audio", "uses_mtkaudio_core_v7_1"), {
        true: ["-DUSES_MTKAUDIO_CORE_V7_1"],
        default: [],
    }),

    shared_libs: [
        "libcutils",
        "libbinder",
        "libbinder_ndk",
        "libhidlbase",
        "liblog",
        "libutils",
        "libhardware",
    ],
}
